{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the Dental Canvas main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:default",
      "allow": [
        { "url": "https://*/*" },
        { "url": "http://*/*" },
        { "url": "mailto:*" },
        { "url": "tel:*" }
      ]
    }
  ]
}
