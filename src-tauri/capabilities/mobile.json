{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Capability for the Dental Canvas Android/iOS apps — only plugins that ship on mobile",
  "windows": ["main"],
  "platforms": ["android", "iOS"],
  "permissions": [
    "core:default",
    "notification:default",
    {
      "identifier": "opener:default",
      "allow": [
        { "url": "https://*/*" },
        { "url": "http://*/*" },
        { "url": "mailto:*" },
        { "url": "tel:*" }
      ]
    }
  ]
}
